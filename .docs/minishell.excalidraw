    {
      "id": "jDQaDZWyA7LR7KCa4kiKt",
      "type": "text",
      "x": -464.8261268160709,
      "y": 5097.918810131508,
      "width": 1152.8023681640625,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3T",
      "roundness": null,
      "seed": 162672450,
      "version": 876,
      "versionNonce": 664912445,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752243180521,
      "link": null,
      "locked": false,
      "text": "typedef struct                s_minishell\n{\n        char                        **envp;                 // Updated environment array of environment variables\n        char                        *input;                 // Result from readline // Expanded line\n        int                         last_exit_status;       // Used for exit and \"$?\" // 0\n        int                         duplicated_std_fds[2];  // Duplicated standard fds in case they are needed during a redirection\n        int                         pid;                    // Process ID, to know if in parent or on child processs // -1\n        t_token                     *tokens_list;           // Linked list of input tokenized // EMPTY\n        t_env                       *environment;           // Linked list of environment variables and values\n        t_cmd                       *cmd_pipelines;         // Linked list of command structures\n}                                         t_minishell;",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "typedef struct                s_minishell\n{\n        char                        **envp;                 // Updated environment array of environment variables\n        char                        *input;                 // Result from readline // Expanded line\n        int                         last_exit_status;       // Used for exit and \"$?\" // 0\n        int                         duplicated_std_fds[2];  // Duplicated standard fds in case they are needed during a redirection\n        int                         pid;                    // Process ID, to know if in parent or on child processs // -1\n        t_token                     *tokens_list;           // Linked list of input tokenized // EMPTY\n        t_env                       *environment;           // Linked list of environment variables and values\n        t_cmd                       *cmd_pipelines;         // Linked list of command structures\n}                                         t_minishell;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Awqcm5c4y3MHKRnreh5nD",
      "type": "text",
      "x": -466.50849883131536,
      "y": 5384.111361279876,
      "width": 950.4019775390625,
      "height": 120,
      "angle": 0,
