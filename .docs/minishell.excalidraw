    {
      "id": "B9kwQ-vCdD4j6L4HIIssT",
      "type": "text",
      "x": 1221.5814614606368,
      "y": 494.0064003789729,
      "width": 633.601318359375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1304853662,
      "version": 93,
      "versionNonce": 832279554,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752182872643,
      "link": null,
      "locked": false,
      "text": "void initialize_minishell(t_minishell *minishell, char **envp)\n{\n        ft_bzero(minishell, sizeof(t_minishell));\n        minishell->environment = regenerate_environment(envp);\n        minishell->environment = check_environment(minishell);\n        minishell->envp = get_environment_array(minishell->environment);\n        minishell->pid = -1;\n        minishell->duplicated_std_fds[0] = dup(STDIN_FILENO);\n        minishell->duplicated_std_fds[1] = dup(STDOUT_FILENO);\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void initialize_minishell(t_minishell *minishell, char **envp)\n{\n        ft_bzero(minishell, sizeof(t_minishell));\n        minishell->environment = regenerate_environment(envp);\n        minishell->environment = check_environment(minishell);\n        minishell->envp = get_environment_array(minishell->environment);\n        minishell->pid = -1;\n        minishell->duplicated_std_fds[0] = dup(STDIN_FILENO);\n        minishell->duplicated_std_fds[1] = dup(STDOUT_FILENO);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
