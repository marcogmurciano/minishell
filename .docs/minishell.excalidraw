      "versionNonce": 1573939485,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752243175036,
      "link": null,
      "locked": false,
      "text": "typedef struct                s_cmd\n{\n        char                        **argv;         // Array of arguments, [0] is command, [>0] are arguments\n        char                        *infile;        // If REDIR_IN present\n        char                        *outfile;       // If REDIR_OUT present\n        int                         append;         // If APPEND present 0 or 1\n        char                        *heredoc;       // If HEREDOC present // Path to temp heredoc file\n        t_cmd                       *next;\n}                                         t_cmd;",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "typedef struct                s_cmd\n{\n        char                        **argv;         // Array of arguments, [0] is command, [>0] are arguments\n        char                        *infile;        // If REDIR_IN present\n        char                        *outfile;       // If REDIR_OUT present\n        int                         append;         // If APPEND present 0 or 1\n        char                        *heredoc;       // If HEREDOC present // Path to temp heredoc file\n        t_cmd                       *next;\n}                                         t_cmd;",
      "autoResize": false,
      "lineHeight": 1.25
    },
