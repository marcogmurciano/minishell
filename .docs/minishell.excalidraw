      "isDeleted": false,
      "boundElements": [],
      "updated": 1752222445133,
      "link": null,
      "locked": false,
      "text": "typedef struct                s_env\n{\n        char                        *key;      // For example: PATH\n        char                        *value;    // For example: /usr/local/bin:/usr/bin:/bin:/usr/local/games\n        char                        *next\n}                                   t_env;",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "typedef struct                s_env\n{\n        char                        *key;      // For example: PATH\n        char                        *value;    // For example: /usr/local/bin:/usr/bin:/bin:/usr/local/games\n        char                        *next\n}                                   t_env;",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "N7COaLe3T0Ir5ZSAWOTfu",
      "type": "text",
      "x": -465.5542407908381,
      "y": 5552.124445715266,
      "width": 1152.811871445901,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
