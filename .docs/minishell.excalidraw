      "updated": 1752179118047,
      "link": null,
      "locked": false,
      "text": "void exit_minishell(t_minishell *minishell)\n{\n    free_minishell(minishell);\n    minishell = NULL;\n    write(STDOUT_FILENO, \"exit\\n\", 5);\n    rl_clear_history();\n    exit(EXIT_SUCCESS);\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void exit_minishell(t_minishell *minishell) \n{\n    free_minishell(minishell);\n    minishell = NULL;\n    write(STDOUT_FILENO, \"exit\\n\", 5);\n    rl_clear_history();\n    exit(EXIT_SUCCESS);\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
