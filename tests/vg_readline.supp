# Comprehensive readline library suppressions
{
   readline_rl_initialize_malloc
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:malloc
   ...
   fun:rl_initialize
   obj:*/libreadline.so*
}
{
   readline_rl_initialize_calloc
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:calloc
   ...
   fun:rl_initialize
   obj:*/libreadline.so*
}
{
   readline_rl_initialize_realloc
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:realloc
   ...
   fun:rl_initialize
   obj:*/libreadline.so*
}
{
   readline_xmalloc_leaks
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:malloc
   fun:xmalloc
   obj:*/libreadline.so*
}
