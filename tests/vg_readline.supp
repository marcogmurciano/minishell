# Fallback globs (in case of different sonames)
{
   readline_fallback
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   obj:*readline*
}
{
   history_fallback
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   obj:*history*
}
{
   tinfo_fallback
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   obj:*tinfo*
}
{
   ncurses_fallback
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   obj:*ncurses*
}
